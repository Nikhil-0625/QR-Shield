# Copy OUTSIDE the Docker build context; never commit real values.
QR_SHIELD_MODE=restricted-demo
PUBLIC_ORIGIN=https://YOUR-DEMO-HOST.example
# Optional additional exact Host headers for provider health probes; no wildcard.
DEMO_ALLOWED_HOSTS=
DEMO_ACCESS_USER=demo
DEMO_ACCESS_PASSWORD=
JWT_SECRET_KEY=
DATABASE_URL=sqlite:////data/demo.db
MODEL_PATH=/app/backend/phishing_model_v2.pkl
# Compute from YOUR trusted unchanged model file; no automatic download/fallback.
MODEL_SHA256=
