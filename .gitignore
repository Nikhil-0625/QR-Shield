.mypy_cache/
.ruff_cache/
*.tmp
*.log

# Generated visual-review artifacts; keep scripts, baselines and reports visible.
/.design-review/*-profile/
/.design-review/profile-*/
/.design-review/*.png
/.design-review/*.jpg
# Synthetic camera image is a reusable decoder-test fixture, not a screenshot.
!/.design-review/camera-captured-synthetic.jpg
/.design-review/*.dom
/.design-review/*-results.json
/.design-review/camera-backend-regressions.txt

