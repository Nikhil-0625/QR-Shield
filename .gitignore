__pycache__/
*.pyc

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.demo.example
*.key
*.pem

# Machine learning model files
*.pkl

# SQLite databases
*.db
*.sqlite
*.sqlite3

# Jupyter checkpoints
.ipynb_checkpoints/

# Editor and system files
.vscode/
.DS_Store
Thumbs.db

# Private offline preprocessing outputs (including quarantine)
/backend/ml/processed_data/
/backend/ml/candidate_artifacts/

# Private source datasets (provenance and redistribution not yet verified)
/backend/ml/*.csv

